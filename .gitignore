# Runtime case blackboards are generated output, never committed
cases/*
!cases/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Deck build scratch (consulting-deck skill writes here)
tmp/

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets
.env
.env.*
memory/
# ...except the committed e2e fixture. SPEC-042's monitoring plan lives under a
# memory root rather than in the case tree, so the bare `memory/` rule above
# silently excluded the fixture SPEC-053's coverage guard depends on — the guard
# passed only on machines where the untracked file happened to exist, and failed
# on a clean checkout (found in SPEC-056).
!tests/fixtures/memory/
!tests/fixtures/memory/**
