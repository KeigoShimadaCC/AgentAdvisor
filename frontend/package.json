{
  "name": "agentadvisor-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AgentAdvisor local web UI (SPEC-033+).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "node scripts/generate-types.cjs",
    "check:clean": "node scripts/generate-types.cjs --check",
    "check:tokens": "node scripts/check-tokens.cjs",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:typecheck": "tsc --noEmit --project e2e/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  }
}
