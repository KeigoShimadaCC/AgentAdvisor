    "ObjectionView": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "materiality": {
          "title": "Materiality",
          "type": "string"
        },
        "objection_id": {
          "title": "Objection Id",
          "type": "string"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "resolution_status": {
          "title": "Resolution Status",
          "type": "string"
        },
        "target_section": {
          "title": "Target Section",
          "type": "string"
        }
      },
      "required": [
        "objection_id",
        "target_section",
        "claim",
        "materiality",
        "resolution_status",
        "reasoning"
      ],
      "title": "ObjectionView",
      "type": "object"
    },
    "PreMortemView": {
      "additionalProperties": false,
      "properties": {
        "assumed_outcome": {
          "title": "Assumed Outcome",
          "type": "string"
        },
        "failure_modes": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Failure Modes",
          "type": "array"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "most_likely_failure_mode": {
          "title": "Most Likely Failure Mode",
          "type": "string"
        }
      },
      "required": [
        "horizon",
        "assumed_outcome",
        "most_likely_failure_mode"
      ],
      "title": "PreMortemView",
      "type": "object"
    },
    "TrackDivergenceView": {
      "additionalProperties": false,
      "properties": {
        "agreement": {
          "title": "Agreement",
          "type": "boolean"
        },
        "divergence_summary": {
          "title": "Divergence Summary",
          "type": "string"
        },
        "positions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Positions",
          "type": "array"
        },
        "reconciled_alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciled Alternative"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "agreement",
        "divergence_summary"
      ],
      "title": "TrackDivergenceView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "objections": {
      "items": {
        "$ref": "#/$defs/ObjectionView"
      },
      "title": "Objections",
      "type": "array"
    },
    "premortem": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreMortemView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "track_divergence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrackDivergenceView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ChallengesRoom",
  "type": "object"
}
