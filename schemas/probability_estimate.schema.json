{
  "$defs": {
    "ProbabilityAdjustment": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^E-\\d+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "delta",
        "evidence_ids"
      ],
      "title": "ProbabilityAdjustment",
      "type": "object"
    },
    "ProbabilityMethod": {
      "enum": [
        "reference_class",
        "scenario_model",
        "structured_subjective"
      ],
      "title": "ProbabilityMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustments": {
      "items": {
        "$ref": "#/$defs/ProbabilityAdjustment"
      },
      "title": "Adjustments",
      "type": "array"
    },
    "base_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Rate"
    },
    "interval_high": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval High"
    },
    "interval_low": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interval Low"
    },
    "method": {
      "$ref": "#/$defs/ProbabilityMethod"
    },
    "point": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point"
    },
    "reference_class": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Class"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "method"
  ],
  "title": "ProbabilityEstimate",
  "type": "object"
}
