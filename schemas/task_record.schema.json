{
  "$defs": {
    "Level": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Level",
      "type": "string"
    },
    "PriorityLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "PriorityLevel",
      "type": "string"
    },
    "TaskRole": {
      "enum": [
        "intake",
        "planner",
        "director",
        "structurer",
        "challenger",
        "premortem",
        "auditor",
        "researcher",
        "analyst",
        "assumption_analyst",
        "synthesizer",
        "reviewer",
        "specialist"
      ],
      "title": "TaskRole",
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "planned",
        "active",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completion_criteria": {
      "minLength": 1,
      "title": "Completion Criteria",
      "type": "string"
    },
    "estimated_cost": {
      "default": 1.0,
      "description": "Estimated cost in expected agent-invocation units.",
      "exclusiveMinimum": 0.0,
      "title": "Estimated Cost",
      "type": "number"
    },
    "expected_information_gain": {
      "$ref": "#/$defs/Level"
    },
    "inputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "issue_node_id": {
      "anyOf": [
        {
          "pattern": "^Q-\\d+(?:\\.\\d+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue Node Id"
    },
    "materiality": {
      "$ref": "#/$defs/Level"
    },
    "priority": {
      "$ref": "#/$defs/PriorityLevel"
    },
    "priority_rationale": {
      "minLength": 1,
      "title": "Priority Rationale",
      "type": "string"
    },
    "priority_score": {
      "maximum": 100,
      "minimum": 1,
      "title": "Priority Score",
      "type": "integer"
    },
    "probability_of_changing_conclusion": {
      "default": 0.5,
      "description": "Estimated probability that this task's output changes the recommendation.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Probability Of Changing Conclusion",
      "type": "number"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "required_output": {
      "minLength": 1,
      "title": "Required Output",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/TaskRole"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "task_id": {
      "pattern": "^T-\\d+$",
      "title": "Task Id",
      "type": "string"
    },
    "why_it_matters": {
      "minLength": 1,
      "title": "Why It Matters",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "role",
    "question",
    "why_it_matters",
    "expected_information_gain",
    "materiality",
    "inputs",
    "required_output",
    "completion_criteria",
    "status",
    "priority",
    "priority_score",
    "priority_rationale"
  ],
  "title": "TaskRecord",
  "type": "object"
}
