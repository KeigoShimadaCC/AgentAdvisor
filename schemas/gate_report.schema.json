{
  "$defs": {
    "GateFinding": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/GateSeverity"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "severity",
        "message"
      ],
      "title": "GateFinding",
      "type": "object"
    },
    "GateSeverity": {
      "description": "Ordered: a gate's outcome is the maximum severity among its findings.",
      "enum": [
        "pass",
        "warn",
        "block"
      ],
      "title": "GateSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Result of the deterministic process gate run at a stage boundary.",
  "properties": {
    "cancelled_task_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Cancelled Task Ids",
      "type": "array"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/GateFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/GateSeverity"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "outcome",
    "checked_at"
  ],
  "title": "GateReport",
  "type": "object"
}
