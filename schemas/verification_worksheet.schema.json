{
  "$defs": {
    "CitationCheckItem": {
      "additionalProperties": false,
      "description": "One claim paired with the excerpts of the evidence it cites.\n\nThe reviewer must return a verdict per item, so \"the citations look fine\" is not\nan available answer.",
      "properties": {
        "cited_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Cited Ids",
          "type": "array"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "dangling_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dangling Ids",
          "type": "array"
        },
        "evidence_excerpts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Excerpts",
          "type": "array"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "claim"
      ],
      "title": "CitationCheckItem",
      "type": "object"
    },
    "GateFinding": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/GateSeverity"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "severity",
        "message"
      ],
      "title": "GateFinding",
      "type": "object"
    },
    "GateSeverity": {
      "description": "Ordered: a gate's outcome is the maximum severity among its findings.",
      "enum": [
        "pass",
        "warn",
        "block"
      ],
      "title": "GateSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "deterministic_findings": {
      "items": {
        "$ref": "#/$defs/GateFinding"
      },
      "title": "Deterministic Findings",
      "type": "array"
    },
    "instructions": {
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CitationCheckItem"
      },
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "instructions"
  ],
  "title": "VerificationWorksheet",
  "type": "object"
}
