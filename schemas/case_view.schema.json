        "assumption_id",
        "claim",
        "type",
        "status",
        "materiality",
        "confidence"
      ],
      "title": "AssumptionView",
      "type": "object"
    },
    "AssumptionsRoom": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/AssumptionView"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "AssumptionsRoom",
      "type": "object"
    },
    "BriefBlock": {
      "additionalProperties": false,
      "description": "One rendered line/element within a brief section, carrying provenance.",
