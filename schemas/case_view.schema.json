{
  "$defs": {
    "ApprovalRecordView": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "title": "Approved By",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "kind": {
          "enum": [
            "framing",
            "final"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "decision",
        "approved_by",
        "approved_at"
      ],
      "title": "ApprovalRecordView",
      "type": "object"
    },
    "AssessedConfidence": {
      "additionalProperties": false,
      "description": "A confidence that was actually assessed (not a coercion default).",
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "kind": {
          "const": "assessed",
          "default": "assessed",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "basis"
      ],
      "title": "AssessedConfidence",
      "type": "object"
    },
    "AssessedStability": {
      "additionalProperties": false,
      "description": "Model stability that was actually assessed (multiple sensitivity runs).",
      "properties": {
        "kind": {
          "const": "assessed",
          "default": "assessed",
          "title": "Kind",
          "type": "string"
        },
        "runs_supporting": {
          "minimum": 0,
          "title": "Runs Supporting",
          "type": "integer"
        },
        "runs_total": {
          "minimum": 1,
          "title": "Runs Total",
          "type": "integer"
        },
        "share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "runs_supporting",
        "runs_total",
        "share"
      ],
      "title": "AssessedStability",
      "type": "object"
    },
    "AssumptionView": {
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "title": "Assumption Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "string"
        },
        "estimate_point": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate Point"
        },
        "evidence_against": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Against",
          "type": "array"
        },
        "evidence_for": {
          "items": {
            "type": "string"
          },
          "title": "Evidence For",
          "type": "array"
        },
        "materiality": {
          "title": "Materiality",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
