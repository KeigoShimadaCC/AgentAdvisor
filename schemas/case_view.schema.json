          "title": "Citation Ids",
          "type": "array"
        },
        "provenance": {
          "title": "Provenance",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "provenance",
        "text"
      ],
