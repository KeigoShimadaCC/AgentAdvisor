          "type": "string"
        }
      },
      "required": [
        "key",
        "status"
      ],
      "title": "BriefSection",
      "type": "object"
    },
    "ChallengesRoom": {
      "additionalProperties": false,
      "properties": {
        "objections": {
          "items": {
            "$ref": "#/$defs/ObjectionView"
          },
          "title": "Objections",
          "type": "array"
        },
        "premortem": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreMortemView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "track_divergence": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrackDivergenceView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ChallengesRoom",
      "type": "object"
    },
    "EffortView": {
      "additionalProperties": false,
